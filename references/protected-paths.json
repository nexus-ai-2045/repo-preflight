{
  "schema": "repo-preflight.protected-paths/v1",
  "description": "保護パスの変更は登録済み署名者の設計・差分判断を照合する。証拠が無い変更と、承認でも免除できない検査変更は停止する。大文字小文字は区別しない。",
  "prefixes": [
    ".github/",
    ".githooks/",
    ".repo-preflight/",
    ".husky/"
  ],
  "exact": [
    ".gitleaks.toml",
    ".gitleaksignore",
    ".gitattributes",
    ".gitmodules",
    ".pre-commit-config.yaml",
    "CODEOWNERS",
    "docs/CODEOWNERS",
    "lefthook.yml",
    "lefthook.yaml"
  ]
}
