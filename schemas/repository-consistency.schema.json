{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nexus-ai-2045/repo-preflight/schemas/repository-consistency.schema.json",
  "title": "repo-preflight repository consistency configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mode"],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "repo-preflight.consistency/v1"},
    "mode": {"enum": ["shadow", "ratchet", "enforce"]},
    "ratchet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline"],
      "properties": {"baseline": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
    },
    "markdown": {"type": "object", "additionalProperties": false, "properties": {"include": {"$ref": "#/$defs/patterns"}}},
    "readme_contracts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "required_paths": {"$ref": "#/$defs/patterns"},
        "commands": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["text"], "properties": {"text": {"type": "string", "minLength": 1}, "paths": {"$ref": "#/$defs/patterns"}}}}
      }
    },
    "impact_map": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["change", "requires_any"], "properties": {"change": {"$ref": "#/$defs/nonEmptyPatterns"}, "requires_any": {"$ref": "#/$defs/nonEmptyPatterns"}}}},
    "generated_artifacts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sources": {"$ref": "#/$defs/patterns"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
  },
  "$defs": {
    "patterns": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "nonEmptyPatterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
