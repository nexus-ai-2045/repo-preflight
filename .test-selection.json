{
  "schema": "test-selection-policy/v1",
  "source_roots": [
    "scripts"
  ],
  "test_roots": [
    "tests"
  ],
  "test_patterns": [
    "test_*.py"
  ],
  "code_suffixes": [
    ".py"
  ],
  "rules": [
    {
      "changes": [
        "CODE_OF_CONDUCT.md",
        "CONTRIBUTING.md",
        "OPERATIONS.md",
        "PREFLIGHT.md",
        "PUBLIC_READY.md",
        "README.md",
        "REPO_GOAL.md",
        "SECURITY.md"
      ],
      "tests": [
        "tests/test_public_narrative_contract.py",
        "tests/test_consistency_gate.py"
      ],
      "dependency_mode": "mapped"
    },
    {
      "changes": [
        "CHANGELOG.md",
        "docs/*.md",
        "references/*.md",
        "docs/*.txt",
        "docs/*.json",
        "references/*.json",
        "runtime/**",
        "assets/**",
        "templates/**",
        "schemas/**",
        "SKILL.md",
        "AGENTS.md"
      ],
      "tests": [
        "tests/test_public_narrative_contract.py",
        "tests/test_consistency_gate.py"
      ],
      "dependency_mode": "supplement"
    },
    {
      "changes": [
        "scripts/local_check.py",
        "tests/test_local_check.py",
        ".test-selection.json",
        ".github/workflows/ci.yml"
      ],
      "tests": [
        "tests/test_local_check.py",
        "tests/test_consistency_gate.py",
        "tests/test_gate_protection.py",
        "tests/test_identity_fixture_exceptions.py",
        "tests/test_ci_policy_ownership.py",
        "tests/test_benchmark_review_tests.py"
      ],
      "dependency_mode": "mapped"
    },
    {
      "changes": [
        ".github/**"
      ],
      "tests": [
        "tests/test_local_check.py",
        "tests/test_consistency_gate.py",
        "tests/test_gate_protection.py"
      ],
      "dependency_mode": "supplement"
    },
    {
      "changes": [
        "pyproject.toml",
        "requirements*.txt",
        "vendor/**"
      ],
      "tests": [
        "tests/test_tool_wheel.py",
        "tests/test_guard_requirements.py",
        "tests/test_release_metadata.py",
        "tests/test_runtime_support.py"
      ],
      "dependency_mode": "supplement"
    },
    {
      "changes": [
        "tests/conftest.py"
      ],
      "tests": [
        "tests/test_fixture_policy_trust.py",
        "tests/test_local_check.py",
        "tests/test_identity_fixture_exceptions.py"
      ]
    },
    {
      "changes": [
        ".repo-preflight-consistency.json",
        ".repo-operating-contracts/**"
      ],
      "tests": [
        "tests/test_consistency_gate.py",
        "tests/test_gate_protection.py"
      ]
    },
    {
      "changes": [
        "tests/*.py"
      ],
      "tests": [
        "tests/test_identity_fixture_exceptions.py"
      ],
      "dependency_mode": "supplement"
    },
    {
      "changes": [
        "CHANGELOG.md",
        "docs/releases/*.md"
      ],
      "tests": [
        "tests/test_release_metadata.py",
        "tests/test_public_narrative_contract.py",
        "tests/test_consistency_gate.py",
        "tests/test_runtime_support.py",
        "tests/test_github_settings_guide.py",
        "tests/test_ai_entry_contract.py"
      ],
      "dependency_mode": "mapped"
    },
    {
      "changes": [
        "pyproject.toml"
      ],
      "tests": [
        "tests/test_release_metadata.py",
        "tests/test_guard_requirements.py",
        "tests/test_tool_wheel.py",
        "tests/test_runtime_support.py"
      ],
      "dependency_mode": "mapped",
      "toml_only_keys": [
        "project.version"
      ]
    },
    {
      "changes": [
        "docs/pr-self-review.md",
        "docs/pr-self-review-trusted-digests.txt"
      ],
      "tests": [
        "tests/test_gate_protection.py"
      ],
      "dependency_mode": "mapped"
    },
    {
      "changes": [
        "scripts/ai_command_guard.py",
        "scripts/identity_gate.py",
        "scripts/identity_normalization.py",
        "scripts/media_identity.py",
        "scripts/mp4_identity.py",
        "scripts/readiness_scan.py",
        "scripts/type1_identity.py"
      ],
      "tests": [
        "tests/test_adv_ai_guard.py",
        "tests/test_guard_requirements.py",
        "tests/test_jpeg_identity.py",
        "tests/test_media_cff_xml_metadata.py",
        "tests/test_media_cover_metadata.py",
        "tests/test_media_identity.py",
        "tests/test_mp4_identity.py",
        "tests/test_pdf_icc.py",
        "tests/test_pdf_text_budget.py",
        "tests/test_png_identity.py",
        "tests/test_readiness_media.py",
        "tests/test_type1_identity.py"
      ],
      "dependency_mode": "supplement"
    },
    {
      "changes": [
        "scripts/benchmark_git_hooks.py"
      ],
      "tests": [
        "tests/test_benchmark_git_hooks.py"
      ],
      "dependency_mode": "mapped"
    },
    {
      "changes": [
        "scripts/ai_command_guard.py"
      ],
      "tests": [
        "tests/test_adv_ai_guard.py",
        "tests/test_adv_eol.py"
      ],
      "dependency_mode": "mapped"
    },
    {
      "changes": [
        "tests/benchmark_review_tests.py"
      ],
      "tests": [
        "tests/test_benchmark_review_tests.py"
      ],
      "dependency_mode": "mapped"
    },
    {
      "changes": [
        "tests/test_review_3c.py",
        "tests/test_review_3c_extra.py",
        "tests/test_review_3c_human.py",
        "tests/test_review_3c_route.py",
        "tests/test_review_3c_tighten.py",
        "tests/test_review_3c_runner.py",
        "tests/test_benchmark_review_tests.py",
        "tests/test_ci_policy_ownership.py"
      ],
      "tests": [
        "tests/test_review_3c.py",
        "tests/test_review_3c_extra.py",
        "tests/test_review_3c_human.py",
        "tests/test_review_3c_route.py",
        "tests/test_review_3c_tighten.py",
        "tests/test_review_3c_runner.py",
        "tests/test_benchmark_review_tests.py",
        "tests/test_ci_policy_ownership.py"
      ],
      "dependency_mode": "mapped"
    },
    {
      "changes": [
        "docs/test-efficiency.md"
      ],
      "tests": [
        "tests/test_public_narrative_contract.py",
        "tests/test_consistency_gate.py"
      ],
      "dependency_mode": "mapped"
    }
  ]
}
